# =============================================================================
# TaskCoper Frontend Client - Environment Template
# =============================================================================
# Copy to .docker/.env.<environment> (for example .env.htm-prod), replace all
# placeholders, then sync it with ENVIRONMENTS=<environment> .docker/sync-env-secrets.sh.

# Application Base URLs
# Baked into the static build at build time (see Dockerfile ARG API_BASE_URL / FILE_BASE_URL,
# exposed to the app as VITE_API_BASE_URL / VITE_FILE_BASE_URL via src/shared/config.ts).
API_BASE_URL=API_BASE_URL
FILE_BASE_URL=FILE_BASE_URL
APP_BASE_URL=APP_BASE_URL
VIETMAP_API_KEY=VIETMAP_API_KEY
VIETMAP_MAP_API_KEY=VIETMAP_MAP_API_KEY

# Goong Maps Configuration
# Baked into the static build at build time (see Dockerfile ARG GOONG_MAP_API_KEY / GOONG_MAP_TILE_API_KEY),
# used by src/tenants/hoa-theo-mua's goong.service.ts and company-address-map.tsx.
GOONG_MAP_API_KEY=GOONG_MAP_API_KEY
GOONG_MAP_TILE_API_KEY=GOONG_MAP_TILE_API_KEY

# Docker Registry Configuration (for compose.yaml)
REGISTRY=localhost/taskcoper
TAG=local
