{
  "name": "taskcoper-fe",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:prod": "vite --mode production",
    "build": "tsc -b && vite build",
    "build:dev": "tsc -b && vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "postinstall": "node .husky/install.mjs",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "i18n:extract": "i18next-cli extract",
    "i18n:extract:check": "i18next-cli extract --dry-run --ci --quiet",
    "i18n:status": "i18next-cli status",
    "i18n:types": "i18next-cli types --quiet",
    "i18n:lint": "i18next-cli lint --quiet",
    "i18n:check": "i18n-check --locales src/lib/i18n/locales --source en --format i18next --unused src/components src/features src/hooks src/layouts src/lib src/pages src/routes src/services src/shared src/styles src/types src/main.tsx --only missingKeys invalidKeys undefined --reporter summary",
    "i18n:unused": "node scripts/i18n-find-unused.mjs",
    "i18n:unused:fix": "node scripts/i18n-find-unused.mjs --fix",
    "i18n:verify": "yarn run i18n:extract:check && yarn run i18n:status && yarn run i18n:check && yarn run i18n:lint && yarn run i18n:types",
    "check": "yarn run lint && yarn run i18n:verify && tsc -b",
    "docker:build": "docker compose -f .docker/docker-compose.yml build --no-cache && docker compose -f .docker/docker-compose.yml up -d"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write --ignore-unknown"
    ],
    "*.{js,mjs,cjs,json,md,css,scss,html,yml,yaml}": "prettier --write --ignore-unknown"
  },
